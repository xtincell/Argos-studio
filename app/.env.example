# Public site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Database (Prisma)
# Dev : SQLite (zero setup, embedded). Path is relative to prisma/schema.prisma.
# Production : swap to Postgres + pgvector.
DATABASE_URL=file:./dev.db
# Production example :
# DATABASE_URL=postgresql://argos:password@localhost:5432/argos?schema=public

# Auth.js (post-bootstrap)
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_RESEND_KEY=

# LLM (Anthropic) — server-only
ANTHROPIC_API_KEY=

# Embeddings (Voyage AI) — server-only
VOYAGE_API_KEY=

# Storage (Cloudflare R2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=argos-assets

# Analytics
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Error tracking
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# Feature flags (post-bootstrap)
NEXT_PUBLIC_ENABLE_CONSULTATIONS=false
