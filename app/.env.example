# Public site URL
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Database (Prisma)
# SQLite. Relative paths are relative to prisma/schema.prisma; the container image uses
# file:/data/argos.db on its persistent volume.
# PostgreSQL + pgvector is a separate migration, not a DATABASE_URL-only switch.
DATABASE_URL=file:./dev.db
# Future target only (not supported by this SQLite schema/migration set):
# DATABASE_URL=postgresql://argos:password@localhost:5432/argos?schema=public

# Single administration key (server-only, min 24 characters; ADR-0009).
# Required by every write and every /admin page or route, as `Authorization: Bearer`
# (La Fusée's Argos Studio connection) or through the session opened at /admin/login.
# Missing or shorter key: administration closed, public reads unaffected.
# Changing it ends every browser session. ARGOS_INGEST_API_KEY is no longer read.
ARGOS_ADMIN_KEY=

# Container image only: allow a library outside a mounted volume (throw-away trial).
# ARGOS_ALLOW_EPHEMERAL_DB=1

# Not read by the application today (Auth.js superseded by ADR-0009, LLM/storage/analytics
# not wired). Kept for the documented future modules only.
# Auth.js (post-bootstrap)
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
AUTH_RESEND_KEY=

# LLM (Anthropic) — server-only
ANTHROPIC_API_KEY=

# Embeddings (Voyage AI) — server-only
VOYAGE_API_KEY=

# Storage (Cloudflare R2)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=argos-assets

# Analytics
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://eu.i.posthog.com

# Error tracking
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_AUTH_TOKEN=

# Feature flags (post-bootstrap)
NEXT_PUBLIC_ENABLE_CONSULTATIONS=false
