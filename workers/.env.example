# Anthropic API key — required for live LLM extraction.
# Without it, the worker falls back to fixture-based dry-run mode.
ANTHROPIC_API_KEY=

# LLM model selection
ARGOS_LLM_MODEL=claude-sonnet-4-6
ARGOS_LLM_CRITIQUE_MODEL=claude-opus-4-7

# Logging
LOG_LEVEL=info

# Network behaviour
ARGOS_USER_AGENT=Argos-Crawler/0.1 (+https://argos.studio/about)
ARGOS_RATE_LIMIT_MS=1500
ARGOS_FETCH_TIMEOUT_MS=20000

# Layer 2 watch behaviour
ARGOS_DOSSIER_OUTPUT_DIR=./output
